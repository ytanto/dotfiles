{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Edit",
      "Write",
      "Read",
      "Bash(mkdir *)",
      "Bash(rg *)",
      "Bash(lsof *)",
      "Bash(time *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(git mv *)",
      "Bash(git --no-pager *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git symbolic-ref *)",
      "Bash(git diff *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh api *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh issue *)",
      "Bash(/usr/bin/make *)",
      "Bash(npx tsc*)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:github.com)",
      "mcp__ide__getDiagnostics",
      "mcp__plugin_figma_figma__*",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_run_code_unsafe",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__context7__*"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(~/.ssh/**)",
      "Read(~/.zshenv.local)",
      "Read(~/.config/gmail-fetch/**)",
      "Read(~/.config/gspread/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(**/*private*key*)",
      "Read(**/*secret*key*)",
      "Read(**/*.key)",
      "Read(**/*access*key*)",
      "Read(**/*google-service-account-key*)",
      "Edit(.env*)",
      "Edit(**/secrets/**)",
      "Bash(psql *)",
      "Bash(mysql *)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "find-skills": "off",
    "herdr": "off",
    "grill-me": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/share/mise/shims/ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "expo-app-design@expo-plugins": false,
    "upgrading-expo@expo-plugins": false,
    "expo-deployment@expo-plugins": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright-cli@playwright-cli": false,
    "ruby-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "crosslog@crosslog-plugins": true,
    "swift-lsp@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "crosslog-plugins": {
      "source": {
        "source": "github",
        "repo": "crossloglife/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "language": "japanese",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "autoUpdates": true
}
