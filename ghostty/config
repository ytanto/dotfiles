# フォント
font-family = Fira Code
font-size = 18
font-style = Regular

# カーソル
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Option を Alt(Meta) として PTY に送る。Claude Code の meta+ 系
# ショートカット（push-to-talk / モデル選択など）を使うため。
# 代償として Option+文字 の特殊文字入力は無効になる。
macos-option-as-alt = true

# その他
mouse-scroll-multiplier = 0.2
clipboard-read = allow
clipboard-write = allow
#keybind = global:ctrl+space=toggle_quick_terminal

# herdr 連携
# ==========
# Cmd 系ショートカットを herdr の prefix シーケンス (ctrl+x = \x18) に
# 変換して送る。macOS では Cmd キーが端末エミュレータ止まりで PTY 内の
# herdr に届かないため、Ghostty 側で prefix+キー のバイト列へ写像する。
# ブラケットは物理キー名だと配列差でマッチしないため、押下文字リテラルで指定。
keybind = cmd+t=text:\x18c
# 名前を聞かずに新規タブ（herdr 側の custom command）
keybind = cmd+shift+t=text:\x18C

# ペイン移動（[ ] 左右、shift 付きで上下）
keybind = cmd+[=text:\x18h
keybind = cmd+]=text:\x18l
keybind = cmd+shift+[=text:\x18k
keybind = cmd+shift+]=text:\x18j

# タブ切替
# Cmd+数字や Cmd+Shift+[ ] は macOS がメニューショートカットとして先に
# 処理するため keybind で奪えない。メニューに取られない Ctrl 系を使う。
keybind = ctrl+tab=text:\x18n
keybind = ctrl+shift+tab=text:\x18p

# スペース（workspace）切替（herdr 側は prefix+u / prefix+d）
keybind = cmd+arrow_up=text:\x18u
keybind = cmd+arrow_down=text:\x18d

# エージェント行フォーカス切替（herdr 側は prefix+i / prefix+m）
keybind = cmd+shift+arrow_up=text:\x18i
keybind = cmd+shift+arrow_down=text:\x18m

# 分割 / 閉じる
keybind = cmd+d=text:\x18v
keybind = cmd+shift+d=text:\x18-
keybind = cmd+w=text:\x18x