# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms



# フォント
font-family = Fira Code
font-size = 18
font-style = Regular

# カーソル
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# その他
clipboard-read = allow
clipboard-write = allow
#keybind = global:ctrl+space=toggle_quick_terminal

# herdr 連携
# ==========
# Cmd 系ショートカットを herdr の prefix シーケンス (ctrl+x = \x18) に
# 変換して送る。macOS では Cmd キーが端末エミュレータ止まりで PTY 内の
# herdr に届かないため、Ghostty 側で prefix+キー のバイト列へ写像する。
# ブラケットは物理キー名だと配列差でマッチしないため、押下文字リテラルで指定。
keybind = cmd+t=text:\x18c

# ペイン移動（[ ] 左右、shift 付きで上下）
keybind = cmd+[=text:\x18h
keybind = cmd+]=text:\x18l
keybind = cmd+shift+[=text:\x18k
keybind = cmd+shift+]=text:\x18j

# タブ切替
# Cmd+数字や Cmd+Shift+[ ] は macOS がメニューショートカットとして先に
# 処理するため keybind で奪えない。メニューに取られない Ctrl 系を使う。
keybind = ctrl+tab=text:\x18n
keybind = ctrl+shift+tab=text:\x18p

# スペース（workspace）切替（herdr 側は prefix+u / prefix+d）
keybind = cmd+arrow_up=text:\x18u
keybind = cmd+arrow_down=text:\x18d

# エージェント行フォーカス切替（herdr 側は prefix+i / prefix+m）
keybind = cmd+shift+arrow_up=text:\x18i
keybind = cmd+shift+arrow_down=text:\x18m

# 分割 / 閉じる
keybind = cmd+d=text:\x18v
keybind = cmd+shift+d=text:\x18-
keybind = cmd+w=text:\x18x